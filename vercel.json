{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "apps/web-app/dist/web-app",
  "builds": [
    { "src": "server/server.mjs", "use": "@vercel/node" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "server/server.mjs" }
  ]
}
